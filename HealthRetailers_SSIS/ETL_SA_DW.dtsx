            <component refId="Package\alim_dim_client\SA_Client" componentClassID="Microsoft.OLEDBSource" contactInfo="Source OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7" description="Source OLE DB" name="SA_Client" usesDispositions="true" version="7">
              <properties>
                <property dataType="System.Int32" description="Nombre de secondes avant l'expiration d'une commande.  Une valeur égale à 0 indique un délai d'expiration infini." name="CommandTimeout">0</property>
                <property dataType="System.String" description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes." name="OpenRowset" />
                <property dataType="System.String" description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes." name="OpenRowsetVariable" />
                <property dataType="System.String" description="Commande SQL à exécuter." name="SqlCommand" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH ventes_docs AS (
    SELECT d.Id, d.Transaction_Id
    FROM Documents_SA d
    WHERE d.State = '1'
      AND d.DocumentType_Id IN ('1','4','5','6','7')
      AND NOT EXISTS (SELECT 1 FROM RelatedDocuments_SA r WHERE r.Document1_Id = d.Id)
      AND EXISTS (SELECT 1 FROM DocumentItem_SA i
                  WHERE i.Document_Id = d.Id
                    AND NULLIF(LTRIM(RTRIM(i.ProductStock_Id)), '') IS NOT NULL)
),
ids AS (
    SELECT ISNULL(TRY_CAST(NULLIF(LTRIM(RTRIM(t.Company_Id)), '') AS INT), -1) AS Company_Id
    FROM ventes_docs v
    LEFT JOIN Transactions_SA t ON t.Id = v.Transaction_Id
    UNION SELECT -1
    UNION SELECT 2
    UNION SELECT TRY_CAST(c.Id AS INT)
          FROM CompaniesList_SA c
          JOIN Clients_SA cl ON LTRIM(RTRIM(cl.Code)) = LTRIM(RTRIM(c.Code))
)
SELECT i.Company_Id,
       CAST(CASE WHEN i.Company_Id = -1 THEN N'NON RENSEIGNE'
                 WHEN i.Company_Id = 2  THEN N'Client comptoir (anonyme)'
                 ELSE COALESCE(
                      NULLIF(LTRIM(RTRIM(SUBSTRING(r.NomRep, CHARINDEX(NCHAR(8212), r.NomRep) + 1, 200))), ''),
                      NULLIF(LTRIM(RTRIM(REPLACE(c.Name, '|', ''))), ''),
                      N'NON RENSEIGNE') END AS NVARCHAR(200)) AS Nom,
       CAST(CASE WHEN i.Company_Id = -1 THEN N'NON RENSEIGNE'
                 WHEN i.Company_Id = 2  THEN N'COMPTOIR_ANONYME'
                 WHEN r.NomRep LIKE N'%Client particulier%' THEN N'PARTICULIER'
                 WHEN r.NomRep LIKE N'%Laboratoire%'         THEN N'B2B - LABORATOIRE'
                 ELSE N'NON RENSEIGNE' END AS NVARCHAR(30)) AS TypeClient,
       CAST(CASE WHEN i.Company_Id IN (-1, 2) THEN 0 ELSE 1 END AS BIT) AS EstClientIdentifie
FROM ids i
LEFT JOIN CompaniesList_SA c  ON TRY_CAST(c.Id AS INT) = i.Company_Id
LEFT JOIN Clients_SA cl       ON LTRIM(RTRIM(cl.Code)) = LTRIM(RTRIM(c.Code))
CROSS APPLY (SELECT dbo.fn_reparer_accents(cl.Nom) AS NomRep) r
WHERE i.Company_Id IS NOT NULL;</property>
                <property dataType="System.String" description="Variable contenant la commande SQL à exécuter." name="SqlCommandVariable" />
                <property dataType="System.Int32" description="Spécifie la page de codes de la colonne à utiliser lorsque les informations de page de codes ne sont pas disponibles à partir de la source de données." name="DefaultCodePage">1252</property>
                <property dataType="System.Boolean" description="Force l'utilisation de la valeur de propriété DefaultCodePage lors de la description des données caractères." name="AlwaysUseDefaultCodePage">false</property>
                <property dataType="System.Int32" description="Spécifie le mode utilisé pour accéder à la base de données." name="AccessMode" typeConverter="AccessMode">2</property>
                <property dataType="System.String" description="Mappages entre les paramètres de la commande SQL et les variables." name="ParameterMapping" />
              </properties>
              <connections>
                <connection refId="Package\alim_dim_client\SA_Client.Connections[OleDbConnection]" connectionManagerID="{86260499-4F22-4727-BD63-EEF3CEBCD0DD}:invalid" connectionManagerRefId="{86260499-4F22-4727-BD63-EEF3CEBCD0DD}:invalid" description="Connexion OLE DB en cours d'exécution utilisée pour accéder à la base de données." name="OleDbConnection" />
              </connections>
              <outputs>
                <output refId="Package\alim_dim_client\SA_Client.Outputs[Sortie de source OLE DB]" name="Sortie de source OLE DB">
                  <outputColumns>
                    <outputColumn refId="Package\alim_dim_client\SA_Client.Outputs[Sortie de source OLE DB].Columns[Company_Id]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="FailComponent" externalMetadataColumnId="Package\alim_dim_client\SA_Client.Outputs[Sortie de source OLE DB].ExternalColumns[Company_Id]" lineageId="Package\alim_dim_client\SA_Client.Outputs[Sortie de source OLE DB].Columns[Company_Id]" name="Company_Id" truncationRowDisposition="FailComponent" />
