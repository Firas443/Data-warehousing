            <component refId="Package\alim_dim_fournisseur\SA_Fournisseur" componentClassID="Microsoft.OLEDBSource" contactInfo="Source OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7" description="Source OLE DB" name="SA_Fournisseur" usesDispositions="true" version="7">
              <properties>
                <property dataType="System.Int32" description="Nombre de secondes avant l'expiration d'une commande.  Une valeur égale à 0 indique un délai d'expiration infini." name="CommandTimeout">0</property>
                <property dataType="System.String" description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes." name="OpenRowset" />
                <property dataType="System.String" description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes." name="OpenRowsetVariable" />
                <property dataType="System.String" description="Commande SQL à exécuter." name="SqlCommand" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH ids AS (
    SELECT TRY_CAST(c.Id AS INT) AS Fournisseur_Id
    FROM CompaniesList_SA c
    WHERE LTRIM(RTRIM(c.CompanyType_Id)) = '2'
    UNION
    SELECT TRY_CAST(t.Company_Id AS INT)
    FROM Documents_SA d
    JOIN Transactions_SA t ON t.Id = d.Transaction_Id
    WHERE d.State = '1' AND d.DocumentType_Id IN ('20','23')
      AND NULLIF(LTRIM(RTRIM(t.Company_Id)), '') IS NOT NULL
)
SELECT i.Fournisseur_Id,
       CAST(COALESCE(
            dbo.fn_reparer_accents(
  CASE WHEN f.Nom LIKE '[0-9]%. %'
       THEN LTRIM(RTRIM(SUBSTRING(f.Nom, CHARINDEX('. ', f.Nom) + 2, 200)))
       ELSE LTRIM(RTRIM(f.Nom)) END),
            LTRIM(RTRIM(REPLACE(c.Name, '|', ''))),
            N'FOURNISSEUR INCONNU ' + CAST(i.Fournisseur_Id AS NVARCHAR(10))
       ) AS NVARCHAR(200)) AS Nom
FROM ids i
LEFT JOIN CompaniesList_SA c ON TRY_CAST(c.Id AS INT) = i.Fournisseur_Id
LEFT JOIN Fournisseurs_SA   f ON LTRIM(RTRIM(f.Code)) = LTRIM(RTRIM(c.Code))
WHERE i.Fournisseur_Id IS NOT NULL
UNION ALL
SELECT -1, N'NON RENSEIGNE';</property>
                <property dataType="System.String" description="Variable contenant la commande SQL à exécuter." name="SqlCommandVariable" />
                <property dataType="System.Int32" description="Spécifie la page de codes de la colonne à utiliser lorsque les informations de page de codes ne sont pas disponibles à partir de la source de données." name="DefaultCodePage">1252</property>
                <property dataType="System.Boolean" description="Force l'utilisation de la valeur de propriété DefaultCodePage lors de la description des données caractères." name="AlwaysUseDefaultCodePage">false</property>
