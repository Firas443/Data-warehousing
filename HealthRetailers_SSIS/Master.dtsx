<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" DTS:refId="Package" DTS:CreationDate="10/28/2026 3:39:05 PM" DTS:CreationName="Microsoft.Package" DTS:CreatorComputerName="LAPTOP-0G1MB6U7" DTS:CreatorName="LAPTOP-0G1MB6U7\amoul" DTS:DTSID="{ACB6B141-44FD-4608-BE92-75D141978B08}" DTS:ExecutableType="Microsoft.Package" DTS:LastModifiedProductVersion="17.0.1016.0" DTS:LocaleID="1036" DTS:ObjectName="Master" DTS:PackageType="5" DTS:ProtectionLevel="0" DTS:VersionBuild="2" DTS:VersionGUID="{72C264A7-7B10-465F-8095-6BB72B08B9E5}">
