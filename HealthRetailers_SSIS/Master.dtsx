  <DTS:Executables>
    <DTS:Executable DTS:refId="Package\EL_SI_SA" DTS:CreationName="Microsoft.ExecutePackageTask" DTS:Description="Tâche d'exécution de package" DTS:DTSID="{94888D11-A464-49F9-8FE7-3457AD94B03E}" DTS:ExecutableType="Microsoft.ExecutePackageTask" DTS:LocaleID="-1" DTS:ObjectName="EL_SI_SA" DTS:TaskContact="Microsoft Corporation; Microsoft SQL Server; Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
