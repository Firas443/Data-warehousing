    <DTS:Executable DTS:refId="Package\ETL_SA_DW" DTS:CreationName="Microsoft.ExecutePackageTask" DTS:Description="Tâche d'exécution de package" DTS:DTSID="{2C93A189-6D0C-4688-8C07-211C89DA3524}" DTS:ExecutableType="Microsoft.ExecutePackageTask" DTS:LocaleID="-1" DTS:ObjectName="ETL_SA_DW" DTS:TaskContact="Microsoft Corporation; Microsoft SQL Server; Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
